# ===== Chung =====
DISCORD_TOKEN=
# Server chạy daily report (nhiều server cách nhau bằng dấu phẩy)
DISCORD_GUILD_IDS=

# ===== Daily report =====
# Role nhận phiếu daily report qua DM
REPORT_ROLE_IDS=
# Channel nhận kết quả report
REPORT_CHANNEL_ID=
REPORT_START_TIME=08:00
REPORT_END_TIME=17:00

# ===== Sprint / meeting notification (bỏ trống SPRINT_CALENDAR_ICS_URL để tắt) =====
# Google Calendar > Settings > Integrate calendar > "Secret address in iCal format"
SPRINT_CALENDAR_ICS_URL=
# Channel nhận thông báo lịch họp
SPRINT_NOTIFY_CHANNEL_ID=
# Role được ping và được vào phòng họp
SPRINT_ROLE_IDS=
# Category chứa voice channel phòng họp (bỏ trống = cùng category với channel thông báo)
SPRINT_VOICE_CATEGORY_ID=
# Từ khóa trong title, cách nhau bằng dấu phẩy. `*` khớp chuỗi bất kỳ: `[WG] Sprint*#*` khớp "[WG] Sprint Planning #18"
# Bắt buộc để trong dấu nháy kép vì có ký tự #
SPRINT_KEYWORDS="[WG] Sprint*#*"
SPRINT_ORGANIZER_EMAIL=
# Giờ nhắc lịch họp trong ngày (HH:mm, giờ Việt Nam)
SPRINT_REMIND_TIME=08:00
SPRINT_POLL_INTERVAL_MINUTES=5
